{
  "name": "ecommerce-playwright-automation",
  "version": "1.0.0",
  "description": "E-commerce automation testing using Playwright",
  "scripts": {
    "test": "npx playwright test",
    "test:headed": "npx playwright test --headed",
    "test:login": "npx playwright test tests/login.spec.js",
    "test:cart": "npx playwright test tests/cart.spec.js",
    "test:checkout": "npx playwright test tests/checkout.spec.js",
    "report": "npx playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0"
  }
}